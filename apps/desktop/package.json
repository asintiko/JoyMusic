{
  "name": "@joymusic/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Joy Music DJ console and stage window",
  "author": "Joy Music",
  "homepage": "https://joymusic.uz",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dev:shim": "vite --config vite.shim.config.ts",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "screenshots": "E2E_SCREENSHOTS=1 vitest run --config vitest.e2e.config.ts e2e/screenshots.e2e.test.ts",
    "dist:dir": "electron-vite build && electron-builder --config electron-builder.config.ts --dir",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.ts --mac",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.config.ts --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "optionalDependencies": {
    "prolink-connect": "^0.11.0",
    "stagelinq": "^3.5.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/notarize": "^3.1.1",
    "@joymusic/brand": "workspace:*",
    "@joymusic/dj-bridge": "workspace:*",
    "@joymusic/qr": "workspace:*",
    "@joymusic/shared": "workspace:*",
    "@joymusic/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.49.0",
    "playwright-core": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
