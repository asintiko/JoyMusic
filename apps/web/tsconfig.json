{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "../../packages/qr/src/opentype.d.ts",
    "next.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src",
    "tests",
    "e2e",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "dist/next-e2e/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
